# Canonical host used by the IndexNow script. Sitemap and JSON-LD use
# site.url in src/content/site.ts. The Worker also sets NEXT_PUBLIC_SITE_URL
# in wrangler.jsonc.
NEXT_PUBLIC_SITE_URL=https://www.renewimplants.ca

# Quiz leads are stored in the D1 binding DB (d1/migrations), not in env vars.
# Apply the migration locally with: npm run d1:migrate:local

# Google Analytics 4 measurement ID (the live site used G-YZG16B3H0V).
# Read when the root layout renders. Set it in the shell before `npm run build:vinext`
# so prerendered HTML includes the tag. See MIGRATION.md.
NEXT_PUBLIC_GA_ID=

# Search engine ownership verification tokens (meta tag values only).
# Same build-time rule as NEXT_PUBLIC_GA_ID.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# IndexNow key: 8–128 hex chars. The same value must be served at
# /<key>.txt (public/<key>.txt). Used by `npm run indexnow` after a deploy.
# Not read by the Worker.
INDEXNOW_KEY=
