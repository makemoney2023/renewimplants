# Canonical host used for metadata, sitemap, JSON-LD, and IndexNow.
NEXT_PUBLIC_SITE_URL=https://www.renewimplants.ca

# Supabase (server only). Quiz leads are written by /api/quiz-leads with the
# service-role key; the table has RLS on and no client policies.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4 measurement ID (the live site used G-YZG16B3H0V).
NEXT_PUBLIC_GA_ID=

# Search engine ownership verification tokens (meta tag values only).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# IndexNow key: 8–128 hex chars. The same value must be served at
# /<key>.txt (public/<key>.txt). Used by scripts/submit-indexnow.mjs.
INDEXNOW_KEY=
