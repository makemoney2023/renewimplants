{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "renewimplants",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/_vinext/static-cache/*"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // Open Graph, Twitter, and canonical URLs. Prerender bakes this at build
  // time, so set it in the build environment as well as here.
  // Preview: https://renewimplants.abracadabra-ai.workers.dev
  // Production: https://www.renewimplants.ca
  // Unset falls back to site.url in src/content/site.ts.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.renewimplants.ca"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "renewimplants-leads",
      // Created in the Cloudflare account. The quiz_leads migration is already applied.
      "database_id": "9a27ec79-78cd-4dc1-af24-2eea59d72701",
      "migrations_dir": "d1/migrations"
    }
  ]
}
