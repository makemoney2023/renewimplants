{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/content/site": ["./src/profile/site.ts"],
      "@/content/nav": ["./src/profile/nav.ts"],
      "@/content/routes": ["./src/profile/routes.ts"],
      "@/content/testimonials": ["./src/profile/testimonials.ts"],
      "@clinic/*": ["./src/*"],
      "@shell/*": ["../shared/*"],
      "@/*": ["../../src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "next.config.ts",
    "vitest.config.ts",
    "../shared/renew/**/*.ts",
    "../shared/renew/**/*.tsx",
    "../shared/lib/leads.ts",
    "../shared/lib/phone.ts",
    "../shared/lib/contrast.ts",
    "../shared/quiz/**/*.ts",
    "../shared/components/lead-form.tsx",
    "../shared/types.ts",
    "../shared/vite-alias.ts"
  ],
  "exclude": ["node_modules", "dist", ".next", ".vinext"]
}
