{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orleans-denture-clinic",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/_vinext/static-cache/*"]
  },
  // Prerender bakes NEXT_PUBLIC_SITE_URL and MEDIA_BASE_URL. Set the same
  // values in the build:vinext script.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://orleansdentureclinic.com",
    "MEDIA_BASE_URL": "https://pub-5816dac948084d6bbbebbfef2581cc24.r2.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orleans-denture-clinic-leads",
      // PLACEHOLDER. This is not a Cloudflare database id.
      // Before the first deploy, create the database and replace this value:
      //   npx wrangler d1 create orleans-denture-clinic-leads
      //   npx wrangler d1 migrations apply DB --remote
      "database_id": "00000000-0000-4000-8000-0000000000a1",
      "migrations_dir": "d1/migrations"
    }
  ]
}
